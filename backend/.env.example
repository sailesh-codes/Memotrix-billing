# ==========================================
# Memotrix Backend Environment Configuration
# Template File: Copy this to .env and supply your secrets
# ==========================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Configuration
# Provide your MongoDB Atlas connection string here
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/memotrix?retryWrites=true&w=majority
MONGODB_DB_NAME=memotrix

# Security, Sessions & Encryption (Generate strong random 32+ char strings)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
ENCRYPTION_KEY=your_encryption_key_32bytes_long_here!
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here!
ADMIN_INITIAL_PASSWORD=YourSecureAdminPassword123!
ADMIN_ALERT_EMAIL=teammemotrix@gmail.com

# SMTP Email Configuration (Gmail App Password)
# NOTE: Gmail SMTP requires an App Password (16-char) when 2-Step Verification is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Memotrix Security" <your_email@gmail.com>

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006
