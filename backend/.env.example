# Memotrix Backend Environment Configuration
PORT=5000
NODE_ENV=development

# SMTP Email Configuration (Gmail App Password)
# NOTE: Gmail SMTP requires an App Password (16-char) when 2-Step Verification is enabled.
# Generate from: Google Account -> Security -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=teammemotrix@gmail.com
SMTP_PASS=mock_app_password
SMTP_FROM="Memotrix Security" <teammemotrix@gmail.com>

# Security & Sessions
JWT_SECRET=memotrix-super-secret-jwt-key-2026
ADMIN_ALERT_EMAIL=teammemotrix@gmail.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006
